# Copy this file to .env (for `npm start`) or enter the same names in Vercel's
# Project Settings → Environment Variables. Never commit the real values.

# The Gmail address Netflix sends the codes to
GMAIL_USER=you@gmail.com

# A Gmail app password (not your normal password): https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# The family key. Anyone with it can see codes, so use a few random words.
# Letters, numbers and dashes only (it goes in the share link).
ACCESS_KEY=purple-tiger-river-42

# --- Optional ---
# How far back to look when "I've requested" is tapped (seconds)
# LOOKBACK_SECONDS=180
# Folder to search; empty = Gmail "All Mail", falling back to INBOX
# MAILBOX=
# Other email providers
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# Only emails from this domain are read
# SENDER_DOMAIN=netflix.com
# Port for `npm start`
# PORT=3000
